@page "{cardId:int}"
@model CardsFrontend.Pages.Cards.HistoryModel
@{
    ViewData["Title"] = "Transaction History";
}
<h1>Historial de Transacciones</h1>
<p class="text-muted">Tarjeta @(Model.Card?.CardNumber ?? Model.CardId.ToString())</p>

<form method="get" class="row g-3 align-items-end mb-4">
    <input type="hidden" asp-for="CardId" />

    <div class="col-auto">
        <label class="form-label" asp-for="Period">Periodo</label>
        <select class="form-select" asp-for="Period" asp-items="Model.PeriodOptions"></select>
    </div>

    <div class="col-auto">
        <label class="form-label" asp-for="Type">Tipo de movimiento</label>
        <select class="form-select" asp-for="Type" asp-items="Model.TypeOptions"></select>
    </div>

    <div class="col-auto">
        <button type="submit" class="btn btn-primary"><i class="bi bi-funnel"></i> Aplicar filtros</button>
        <a class="btn btn-outline-secondary" asp-page="Details" asp-route-cardId="@Model.CardId"><i class="bi bi-arrow-left"></i> Regresar</a>
    </div>
</form>

<p class="text-muted">@Model.Movements.Count transaccion(es) encontradas.</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Fecha</th>
            <th class="text-end">Monto</th>
            <th>Descripcion</th>
            <th>Tipo</th>
        </tr>
    </thead>
    <tbody>
    @if (Model.Movements.Count == 0)
    {
        <tr><td colspan="4" class="text-center text-muted">No hay transacciones para el filtro seleccionado.</td></tr>
    }
    else
    {
        @foreach (var m in Model.Movements)
        {
            <tr>
                <td>@m.MovementDate.ToString("yyyy-MM-dd HH:mm")</td>
                <td class="text-end">@m.MovementAmount.ToString("N2")</td>
                <td>@m.MovementDescription</td>
                <td>
                    @if (m.MovementType == "Compra")
                    {
                        <span class="badge bg-danger">Compra</span>
                    }
                    else if (m.MovementType == "Pago")
                    {
                        <span class="badge bg-success">Pago</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@m.MovementType</span>
                    }
                </td>
            </tr>
        }
    }
    </tbody>
</table>
