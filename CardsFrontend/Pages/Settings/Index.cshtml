@page
@model CardsFrontend.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "Statement Settings";
}
<h1>Settings</h1>
<p class="text-muted">
    Porcentajes utilizados para calcular interes bonificable y pago minimo. Modificar estos valores afectan globalmente a todos los estados de cuenta.
</p>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success" role="alert">@Model.SuccessMessage</div>
}

<div asp-validation-summary="All" class="alert alert-danger" role="alert"
     style="@(Model.ModelState.ErrorCount == 0 ? "display:none" : "")"></div>

<form method="post" style="max-width: 420px;">
    <div class="mb-3">
        <label class="form-label" asp-for="Settings.InterestPercentage">Porcentaje para Interes Bonificable(%)</label>
        <div class="input-group">
            <input class="form-control" asp-for="Settings.InterestPercentage" type="number" step="0.01" min="0" max="100" />
            <span class="input-group-text">%</span>
        </div>
        <span asp-validation-for="Settings.InterestPercentage" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="Settings.MinimumPaymentPercentage">Porcentaje para Pago Minimo(%)</label>
        <div class="input-group">
            <input class="form-control" asp-for="Settings.MinimumPaymentPercentage" type="number" step="0.01" min="0" max="100" />
            <span class="input-group-text">%</span>
        </div>
        <span asp-validation-for="Settings.MinimumPaymentPercentage" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
</form>
