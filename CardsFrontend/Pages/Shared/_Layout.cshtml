@{
    // Highlights the sidebar entry matching the current page.
    string currentPage = (ViewContext.RouteData.Values["page"]?.ToString() ?? "").ToLowerInvariant();
    string ActiveIf(string prefix) => currentPage.StartsWith(prefix.ToLowerInvariant()) ? "active" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EstadoDeCuenta</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <style>
        :root {
            --brand-red: #c81e1e;
            --brand-red-dark: #a11616;
            --bs-link-color: #c81e1e;
            --bs-link-hover-color: #a11616;
        }

        body {
            background: #fff;
        }

        .app-shell {
            display: flex;
            min-height: 100vh;
        }

        /* ---------- Barra superior (solo móvil) ---------- */
        .topbar {
            display: flex;
            align-items: center;
            gap: .75rem;
            background: var(--brand-red);
            color: #fff;
            padding: .6rem 1rem;
        }

        .topbar .topbar-toggle {
            background: transparent;
            border: 0;
            color: #fff;
            font-size: 1.5rem;
            line-height: 1;
            padding: 0 .25rem;
        }

        .topbar .topbar-brand {
            color: #fff;
            text-decoration: none;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: .5rem;
        }

        /* ---------- Sidebar / drawer ---------- */
        .sidebar {
            width: 240px;
            flex-shrink: 0;
            background: var(--brand-red) !important;
            color: #fff;
            --bs-offcanvas-width: 250px;
        }

        .sidebar .brand {
            padding: 1.25rem 1rem;
            font-size: 1.15rem;
            font-weight: 700;
            color: #fff;
            text-decoration: none;
            align-items: center;
            gap: .6rem;
            border-bottom: 1px solid rgba(255, 255, 255, .2);
        }

        .sidebar .nav-link {
            color: rgba(255, 255, 255, .9);
            padding: .75rem 1rem;
            display: flex;
            align-items: center;
            gap: .75rem;
        }

        .sidebar .nav-link:hover {
            background: var(--brand-red-dark);
            color: #fff;
        }

        .sidebar .nav-link.active {
            background: #fff;
            color: var(--brand-red);
            font-weight: 600;
        }

        .sidebar .nav-link i {
            font-size: 1.15rem;
            width: 1.25rem;
            text-align: center;
        }

        /* ---------- Contenido ---------- */
        .content {
            flex: 1;
            padding: 1.5rem 2rem;
            min-width: 0;
            background: #f5f6f8;
        }

        .content-panel {
            background: #fff;
            border-radius: .5rem;
            box-shadow: 0 1px 4px rgba(0, 0, 0, .08);
            padding: 1.5rem 2rem;
        }

        /* ---------- Acentos rojo / blanco ---------- */
        .btn-primary {
            --bs-btn-bg: var(--brand-red);
            --bs-btn-border-color: var(--brand-red);
            --bs-btn-hover-bg: var(--brand-red-dark);
            --bs-btn-hover-border-color: var(--brand-red-dark);
            --bs-btn-active-bg: var(--brand-red-dark);
            --bs-btn-active-border-color: var(--brand-red-dark);
        }

        .btn-outline-primary {
            --bs-btn-color: var(--brand-red);
            --bs-btn-border-color: var(--brand-red);
            --bs-btn-hover-bg: var(--brand-red);
            --bs-btn-hover-border-color: var(--brand-red);
            --bs-btn-active-bg: var(--brand-red);
            --bs-btn-active-border-color: var(--brand-red);
        }

        h1, h2, h3 {
            color: var(--brand-red-dark);
        }

        @@media (max-width: 767.98px) {
            .content {
                padding: 1rem;
            }

            .content-panel {
                padding: 1rem;
            }
        }
    </style>
</head>
<body>
    <!-- Barra superior con botón de menú (solo en pantallas pequeñas) -->
    <nav class="topbar d-md-none">
        <button class="topbar-toggle" type="button"
                data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu"
                aria-controls="sidebarMenu" aria-label="Abrir menú">
            <i class="bi bi-list"></i>
        </button>
        <a class="topbar-brand" asp-page="/Index">
            <i class="bi bi-credit-card-2-front"></i>
            <span>EstadoDeCuenta</span>
        </a>
    </nav>

    <div class="app-shell">
        <!-- Menú lateral: drawer (offcanvas) en móvil, fijo en escritorio -->
        <nav class="sidebar offcanvas-md offcanvas-start" tabindex="-1" id="sidebarMenu" aria-labelledby="sidebarLabel">
            <div class="offcanvas-header d-md-none">
                <span class="offcanvas-title fw-bold" id="sidebarLabel">Menú</span>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="offcanvas" data-bs-target="#sidebarMenu" aria-label="Cerrar"></button>
            </div>
            <div class="offcanvas-body d-flex flex-column p-0">
                <a class="brand d-none d-md-flex" asp-page="/Index">
                    <i class="bi bi-credit-card-2-front"></i>
                    <span>EstadoDeCuenta</span>
                </a>
                <ul class="nav flex-column mt-md-2">
                    <li class="nav-item">
                        <a class="nav-link @ActiveIf("/index")" asp-page="/Index">
                            <i class="bi bi-house-door"></i><span>Inicio</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveIf("/clients")" asp-page="/Clients/Index">
                            <i class="bi bi-person"></i><span>Clientes</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveIf("/cards")" asp-page="/Cards/Index">
                            <i class="bi bi-credit-card"></i><span>Tarjetas</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveIf("/movements")" asp-page="/Movements/Index">
                            <i class="bi bi-arrow-left-right"></i><span>Movimientos</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveIf("/settings")" asp-page="/Settings/Index">
                            <i class="bi bi-gear"></i><span>Configuraciones</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveIf("/health")" asp-page="/Health/Index">
                            <i class="bi bi-heart-pulse"></i><span>Estado</span>
                        </a>
                    </li>
                </ul>
            </div>
        </nav>

        <main role="main" class="content">
            <div class="content-panel">
                @RenderBody()
            </div>
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
