@page
@model CardsFrontend.Pages.Clients.CreateModel
@{
    ViewData["Title"] = "New Client";
}
<h1>Nuevo Cliente</h1>
<div asp-validation-summary="All" class="alert alert-danger" role="alert" style="@(Model.ModelState.ErrorCount == 0 ? "display:none" : "")"></div>
<form method="post">
    <div class="mb-3">
        <label class="form-label" asp-for="Client.ClientName">Nombre de Cliente</label>
        <input class="form-control" asp-for="Client.ClientName" />
        <span class="text-danger" asp-validation-for="Client.ClientName"></span>
    </div>
    <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Crear</button>
    <a class="btn btn-secondary" asp-page="Index"><i class="bi bi-x-lg"></i> Cancelar</a>
</form>
