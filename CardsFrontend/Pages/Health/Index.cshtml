@page
@model CardsFrontend.Pages.Health.IndexModel
@{
    ViewData["Title"] = "Estado del sistema";
}
<h1>Estado del sistema</h1>
<p class="text-muted">Verifica el estado de la API y su base de datos (endpoint <code>/health</code>).</p>

@if (Model.Health.IsHealthy)
{
    <div class="alert alert-success d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-check-circle-fill fs-4"></i>
        <div>
            <strong>API en funcionamiento</strong><br />
            Estado: @Model.Health.Status
        </div>
    </div>
}
else
{
    <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-x-circle-fill fs-4"></i>
        <div>
            <strong>La API no está disponible</strong><br />
            Estado: @Model.Health.Status
        </div>
    </div>
}

<a class="btn btn-primary" asp-page="Index"><i class="bi bi-arrow-clockwise"></i> Actualizar</a>
